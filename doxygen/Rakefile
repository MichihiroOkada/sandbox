# encoding: CP932
require 'rake'
require 'fileutils'

path=ENV['PATH']
path="#{path};C:\\Users\\oka\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\"
ENV['PATH'] = path
p ENV['PATH']

def delete_japanese(output_dir)
  Dir.chdir("#{output_dir}/latex") do
    # LaTeXに渡す生成ファイルから日本語文字を除く
    Dir.glob("**/*.tex").each do |path|
      text = File.read(path, encoding: "UTF-8")
      text = text.gsub(
        /[\u{3000}-\u{30FF}\u{3400}-\u{4DBF}\u{4E00}-\u{9FFF}\u{F900}-\u{FAFF}\u{FF00}-\u{FFEF}]/,
        ""
      )
      File.write(path, text, encoding: "UTF-8")
    end

    # 前回の日本語を含む目次・補助ファイルを消して作り直す
    %w[refman.aux refman.toc refman.out].each do |path|
      File.delete(path) if File.exist?(path)
    end

    sh "make.bat" do |ok, status|
      warn "ErrorCode: #{status.exitstatus}" unless ok
    end
  end
end

def delete_hierarchical(output_dir)
  # doxygen Doxyfile の直後、make.bat の前に実行
  refman = Pathname("#{output_dir}/latex/refman.tex")
  tex = refman.read(encoding: "UTF-8")

  pattern = /^[ \t]*\\(?:chapter|doxysection)\{Hierarchical Index\}\r?\n\\input\{hierarchy\}\r?\n/
  tex.sub!(pattern, "")
  refman.write(tex, encoding: "UTF-8")
end

task 'generate' do
  docname = "API仕様書_BBB.pdf"
  output_dir = "docs"
  sh "rm -rf #{output_dir}"
  FileUtils.mkdir_p("#{output_dir}/latex")
  sh "cp confidential.png #{output_dir}/latex"
  sh "cp logo.png #{output_dir}/latex"

  sh 'doxygen Doxyfile'
  delete_japanese(output_dir) 
  delete_hierarchical(output_dir) 
  add_section_to_function_def(output_dir) 
  sh "cp confidential.png #{output_dir}/latex"
  sh "cp logo.png #{output_dir}/latex"
  sh "#{output_dir}/latex/make.bat"
  FileUtils.cp("#{output_dir}/latex/refman.pdf", docname)
end

def wrap_prototype_blocks(text)
  #marker = "{\\footnotesize\\ttfamily"
  marker = "{\\footnotesize\\ttfamily \\label{"
  result = +""
  position = 0

  while (start = text.index(marker, position))
    # 開始位置より前をそのまま追加
    result << text[position...start]

    # すでにボックス内なら二重に囲まない
    if result.rstrip.end_with?("\\begin{DoxyPrototypeBox}")
      result << marker
      position = start + marker.length
      next
    end

    result << "\\begin{DoxyPrototypeBox}\n"

    # marker 内の先頭の { を含めて、対応する } を探す
    depth = 0
    cursor = start

    while cursor < text.length
      char = text[cursor]

      depth += 1 if char == "{"
      depth -= 1 if char == "}"

      cursor += 1
      break if depth.zero?
    end

    # 対応する } が見つからなければ、壊さず残す
    if depth != 0
      result << text[start..]
      return result
    end

    #result << text[start...cursor]
    result << text[start...cursor].gsub("\\footnotesize", "")

    result << "\n\\end{DoxyPrototypeBox}"
    position = cursor
  end

  result << text[position..] if position < text.length
  result
end

#{\footnotesize\ttfamily \label{class_cdialogtest_app_a1468045851f89f8b9b9a846c9a48bd65} 
#BOOL Cdialogtest\+App::\+\+Init\+Instance (\begin{DoxyParamCaption}{}{}\end{DoxyParamCaption})\hspace{0.3cm}{\ttfamily [virtual]}}
# を下記に変える
#\begin{DoxyPrototypeBox}
#{\footnotesize\ttfamily \label{class_cdialogtest_app_a1468045851f89f8b9b9a846c9a48bd65}
#BOOL Cdialogtest\+App::\+\+Init\+Instance (\begin{DoxyParamCaption}{}{}\end{DoxyParamCaption})\hspace{0.3cm}{\ttfamily [virtual]}}
#\end{DoxyPrototypeBox}
def add_section_to_function_def(output_dir)
  # --- 追加：生成された class_*.tex 内の関数宣言文を背景色ボックスで包む置換処理 ---
  Dir.glob("#{output_dir}/latex/class*.tex").each do |file|
    text = File.read(file, encoding: 'UTF-8')
    text = wrap_prototype_blocks(text)
    File.write(file, text, encoding: 'UTF-8')
  end
end

task 'generate_header' do
  sh 'doxygen.exe -w latex custom_header.tex custom_footer.tex custom_doxygen.sty Doxyfile'
end

task 'update_tex' do
  #delete_hierarchical
  add_section_to_function_def("docs") 
end



