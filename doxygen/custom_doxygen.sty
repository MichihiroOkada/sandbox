\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{custom_doxygen}[2026/10/24 Custom Doxygen Style]

\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

% 1. Background colors for Doxygen member functions
\definecolor{memprotobg}{RGB}{235, 243, 250}
\definecolor{memoptionbg}{RGB}{235, 243, 250}
\definecolor{memprotocorder}{RGB}{100, 149, 237}

% 2. Formatting for member function prototypes
\makeatletter
\AtBeginDocument{
  \@ifundefined{doxysubsubitem}{}{
    \renewcommand{\doxysubsubitem}[2]{%
      \par\vspace{0.4em}%
      \noindent
      \begin{tcolorbox}[
        colback=memprotobg,
        colframe=memprotocorder,
        boxrule=0.8pt,
        arc=3pt,
        left=6pt, right=6pt, top=4pt, bottom=4pt,
        boxsep=0pt,
        before upper=\raggedright
      ]%
        {\bfseries #1}\ifx&#2&\else\hfill{\small\itshape #2}\fi
      \end{tcolorbox}%
      \par\vspace{0.2em}%
    }%
  }
  \@ifundefined{doxysubitem}{}{
    \renewcommand{\doxysubitem}[2]{%
      \par\vspace{0.4em}%
      \noindent
      \begin{tcolorbox}[
        colback=memprotobg,
        colframe=memprotocorder,
        boxrule=0.8pt,
        arc=3pt,
        left=6pt, right=6pt, top=4pt, bottom=4pt,
        boxsep=0pt,
        before upper=\raggedright
      ]%
        {\bfseries #1}\ifx&#2&\else\hfill{\small\itshape #2}\fi
      \end{tcolorbox}%
      \par\vspace{0.2em}%
    }%
  }
}
\makeatother
