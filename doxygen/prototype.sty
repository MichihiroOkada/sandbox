\RequirePackage[most]{tcolorbox}

\tcbset{
  fonttitle=\bfseries,
  fontupper=\normalsize
}

\let\DoxyOriginalCompactItemize\DoxyCompactItemize
\let\endDoxyOriginalCompactItemize\endDoxyCompactItemize

\renewenvironment{DoxyCompactItemize}
  {\begin{tcolorbox}[
     enhanced,
     breakable,
     colback=gray!5,
     colframe=gray!60,
     boxrule=0.4pt,
     arc=1mm,
     left=2mm,
     right=2mm,
     top=1mm,
     bottom=1mm,
     drop shadow,
     fontupper=\normalsize\ttfamily\bfseries
   ]
   \begin{DoxyOriginalCompactItemize}}
  {\end{DoxyOriginalCompactItemize}
   \end{tcolorbox}}

\usepackage{xcolor}
\usepackage[most]{tcolorbox}

\newenvironment{DoxyPrototypeBox}
  {\begin{tcolorbox}[
    enhanced,
    colback=black!60,
    colframe=black!100,
    coltext=white,
    boxrule=0.4pt,
    arc=1pt,
    left=2mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    boxsep=0pt,
    before skip=10pt,
    after skip=10pt,
    drop shadow,
    fontupper=\large\ttfamily\bfseries
  ]
  \hypersetup{linkcolor=cyan}}
  {\end{tcolorbox}}

\renewenvironment{DoxyNote}
  {\begin{tcolorbox}[
    enhanced,
    colback=yellow!40,
    colframe=yellow!80,
    boxrule=0.4pt,
    arc=1pt,
    left=2mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    boxsep=0pt,
    before skip=10pt,
    after skip=10pt,
    drop shadow,
    fontupper=\normalsize\sffamily
  ]}
  {\end{tcolorbox}}

\renewenvironment{DoxyWarning}
