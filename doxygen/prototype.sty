    enhanced,
    colback=red!30,
    colframe=red!70,
    boxrule=0.4pt,
    arc=1pt,
    left=2mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    boxsep=0pt,
    before skip=10pt,
