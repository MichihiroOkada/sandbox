\RequirePackage[most]{tcolorbox}

\tcbset{
  fonttitle=\bfseries,
  fontupper=\normalsize
}

\let\DoxyOriginalCompactItemize\DoxyCompactItemize
\let\endDoxyOriginalCompactItemize\endDoxyCompactItemize

\renewenvironment{DoxyCompactItemize}
  {\begin{tcolorbox}[
     breakable,
     colback=blue!5,
     colframe=blue!30,
     boxrule=0.4pt,
     arc=1mm,
     left=2mm,
     right=2mm,
     top=1mm,
     bottom=1mm
   ]
   \begin{DoxyOriginalCompactItemize}}
  {\end{DoxyOriginalCompactItemize}
   \end{tcolorbox}}

\usepackage{xcolor}
\usepackage[most]{tcolorbox}

\newenvironment{DoxyPrototypeBox}
  {\begin{tcolorbox}[
    enhanced,
    colback=yellow!8,
    colframe=yellow!30,
    boxrule=0pt,
    arc=0pt,
    left=2mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    boxsep=0pt,
    before skip=10pt,
    after skip=10pt,
    drop shadow,
    fontupper=\Large\rmfamily\bfseries\itshape
  ]}
  {\end{tcolorbox}}